{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/lib/types"],
      "@deepseek-ai/dsh-agent": ["../deepseek-harness/packages/core/agent/lib/types"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session/lib/types"],
      "@deepseek-ai/dsh-session/types": ["../deepseek-harness/packages/core/session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-scope": ["../deepseek-harness/packages/core/scope/lib/types"],
      "@deepseek-ai/dsh-storage-domain": ["../deepseek-harness/packages/storage/storage-domain/lib/types"],
      "@deepseek-ai/dsh-system-prompt": ["../deepseek-harness/packages/core/system-prompt/lib/types"],
      "@deepseek-ai/dsh-workspace": ["../deepseek-harness/packages/workspace/workspace/lib/types"],
      "zod": ["../deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod"]
    }
  },
  "include": ["src"]
}
